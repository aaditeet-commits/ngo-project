<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO - Empowering Lives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-hands-helping text-primary"></i> Hope NGO
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="#programs">Programs</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                    <li class="nav-item"><a class="btn btn-primary btn-sm ms-2" href="#donate">Donate Now</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Banner Slider -->
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <% banners.forEach((banner, index) => { %>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="<%= index %>" 
                        class="<%= index === 0 ? 'active' : '' %>"></button>
            <% }); %>
        </div>
        <div class="carousel-inner">
            <% banners.forEach((banner, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                    <img src="<%= banner.image_url %>" class="d-block w-100" alt="<%= banner.title %>" style="height: 500px; object-fit: cover;">
                    <div class="carousel-caption">
                        <h1 class="display-4 fw-bold"><%= banner.title %></h1>
                        <p class="lead"><%= banner.description %></p>
                        <a href="#donate" class="btn btn-primary btn-lg">Get Involved</a>
                    </div>
                </div>
            <% }); %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- Vision & Mission -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-eye fa-2x text-primary me-3"></i>
                                <h2 class="mb-0"><%= vision_mission.vision_title || 'Our Vision' %></h2>
                            </div>
                            <p class="text-muted"><%= vision_mission.vision_description || 'Creating a better world for everyone.' %></p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-bullseye fa-2x text-success me-3"></i>
                                <h2 class="mb-0"><%= vision_mission.mission_title || 'Our Mission' %></h2>
                            </div>
                            <p class="text-muted"><%= vision_mission.mission_description || 'Empowering communities through education and healthcare.' %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Impact Statistics -->
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-5">Our Impact</h2>
            <div class="row g-4 text-center">
                <% statistics.forEach(stat => { %>
                    <div class="col-md-3 col-sm-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <h1 class="display-4 text-primary fw-bold"><%= stat.value %></h1>
                                <p class="text-muted mb-0"><%= stat.label %></p>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Our Initiatives -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-5">Our Initiatives</h2>
            <div class="row g-4">
                <% initiatives.forEach(initiative => { %>
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <img src="<%= initiative.image_url %>" class="card-img-top" alt="<%= initiative.title %>" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title"><%= initiative.title %></h5>
                                <p class="card-text text-muted"><%= initiative.description %></p>
                                <a href="#" class="btn btn-outline-primary btn-sm">Learn More</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5 bg-primary text-white text-center">
        <div class="container">
            <h2 class="mb-4">Make a Difference Today</h2>
            <p class="lead mb-4">Your support can change lives. Join us in our mission.</p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="#donate" class="btn btn-light btn-lg">Donate Now</a>
                <a href="#volunteer" class="btn btn-outline-light btn-lg">Volunteer</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="fas fa-hands-helping"></i> Hope NGO</h5>
                    <p>Empowering lives, creating opportunities.</p>
                </div>
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">About Us</a></li>
                        <li><a href="#" class="text-white-50">Programs</a></li>
                        <li><a href="#" class="text-white-50">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Connect With Us</h5>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white"><i class="fab fa-facebook fa-2x"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-twitter fa-2x"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram fa-2x"></i></a>
                    </div>
                </div>
            </div>
            <hr class="bg-white">
            <p class="text-center mb-0">&copy; 2024 Hope NGO. All Rights Reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>